{
  "name": "@jupyter-widgets/jupyterlab-manager",
  "version": "5.0.16",
  "description": "The JupyterLab extension providing Jupyter widgets.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab notebook",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/jupyter-widgets/ipywidgets",
  "bugs": {
    "url": "https://github.com/jupyter-widgets/ipywidgets/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyter-widgets/ipywidgets"
  },
  "license": "BSD-3-Clause",
  "author": "Project Jupyter",
  "sideEffects": [
    "style/*.css"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "dist/*.js",
    "schema/*.json"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc -b",
    "build:prod": "jlpm build:lib && jlpm build:labextension",
    "clean": "jlpm clean:lib",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension",
    "clean:labextension": "rimraf labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "jlpm build",
    "prepare": "jlpm clean && jlpm build:prod",
    "watch": "jupyter-builder watch ."
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.12",
    "@jupyter-widgets/base-manager": "^1.0.13",
    "@jupyter-widgets/controls": "^5.0.13",
    "@jupyter-widgets/output": "^6.0.12",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/console": "^4.0.0",
    "@jupyterlab/docregistry": "^4.0.0",
    "@jupyterlab/logconsole": "^4.0.0",
    "@jupyterlab/mainmenu": "^4.0.0",
    "@jupyterlab/nbformat": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/observables": "^5.6.3",
    "@jupyterlab/outputarea": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0",
    "@jupyterlab/rendermime-interfaces": "^3.8.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/settingregistry": "^4.0.0",
    "@jupyterlab/translation": "^4.0.0",
    "@lumino/coreutils": "^2.0.0",
    "@lumino/disposable": "^2.0.0",
    "@lumino/messaging": "^2.0.5",
    "@lumino/properties": "^2.0.5",
    "@lumino/signaling": "^2.0.0",
    "@lumino/widgets": "^2.0.0",
    "@types/backbone": "1.4.14",
    "jquery": "^3.1.1",
    "semver": "^7.3.5"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "@types/jquery": "^3.5.16",
    "@types/node": "^17.0.2",
    "@types/semver": "^7.3.6",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "source-map-loader": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "schemaDir": "./schema"
  }
}
